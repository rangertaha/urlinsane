# IPLD schema for urlinsane scan results. The pipeline mutates a plain Go
# struct (db.Domain); these types are the content-addressed on-disk form,
# encoded as dag-cbor and bound to Go structs in schema.go via bindnode.
#
# An Entity is a keyed union: one variant per entity type (domain, name, user,
# package). Typosquatting applies to any named entity, not just domains.

type Entity union {
  | DomainEntity  "domain"
  | NameEntity    "name"
  | UserEntity    "user"
  | PackageEntity "package"
} representation keyed

type DomainEntity struct {
  name     String
  punycode String
  rank     Int
  redirect String
  dns      [DnsRecord]
  ips      [Address]
  whois    [Whois]
}

type NameEntity struct {
  name String
  rank Int
}

type UserEntity struct {
  name String
  rank Int
}

type PackageEntity struct {
  name     String
  rank     Int
  registry String
}

type DnsRecord struct {
  type  String
  value String
  ttl   String
}

type Address struct {
  addr     String
  type     String
  ports    [Port]
  location optional Location
}

type Port struct {
  proto   String
  number  Int
  state   String
  service String
}

type Location struct {
  code       String
  name       String
  timezone   String
  latitude   Float
  longitude  Float
  postalCode String
}

type Whois struct {
  created        String
  updated        String
  expiration     String
  registrar      optional Contact
  registrant     optional Contact
  administrative optional Contact
  technical      optional Contact
  billing        optional Contact
}

type Contact struct {
  name         String
  organization String
  street       String
  city         String
  province     String
  postalCode   String
  country      String
  phone        String
  phoneExt     String
  fax          String
  faxExt       String
  email        String
  referralURL  String
}

type Scan struct {
  query   String
  created String
  results [Link]
}
