# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env


# IDEs
.idea
.vscode
.dev
.NOTES.md

builds
build
releases
tst

# Personal files
50k.txt
backlinks.txt
compare.md

old/
.git
.txt
.csv
.json
.html
/main

# The binary, when built into the repository root rather than into build/.
#
# Anchored with a leading slash on purpose: an unanchored "urlinsane" would also
# match the cmd/urlinsane directory, and every new file added there would be
# silently ignored. For the same reason there is no /datasets entry -- that is
# the reference-data tree, and the datasets binary builds into build/ already.
/urlinsane


// Debian Packaging
debhelper-build-stamp
.DS_Store
.debhelper
*.deb
*.dsc
*.build
*.buildinfo
*.changes
*.tar.gz
*.log
*.substvars
/.vagrant
/*/debian/hello
/*/debian/files
/*/hello
/tutorial-1/packageroot/usr
*.mmdb
/domains
/obj-x86_64-linux-gnu
**/src
